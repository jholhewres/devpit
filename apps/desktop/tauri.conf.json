{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devpit",
  "version": "0.1.0",
  "identifier": "dev.devpit.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:17800",
    "beforeDevCommand": {
      "cwd": "../../web",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../web",
      "script": "pnpm build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "devpit",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
